    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">b6415b19-fc20-4254-ad30-b3967482ac21</Single>
        <Single Name="ParentGuid" Type="System.Guid">6c8530e3-8d9a-4a65-b2e6-50c5664c7d35</Single>
        <Single Name="Name" Type="string">FbCreateCustomPayload</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">26f5cb85-b5a7-4f34-b57e-3d80537d74bc</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">638993153771930473</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
IF xEnable THEN
    
    (* ----------------------------------------------------------------------
       Sequence Counter with Rollover Protection
       ---------------------------------------------------------------------- *)
    IF uiSeqCounter &gt;= 255 THEN
        uiSeqCounter := 0;
    ELSE
        uiSeqCounter := uiSeqCounter + 1;
    END_IF;
    
    (* ----------------------------------------------------------------------
       Timestamp Generation (milliseconds since system start)
       ---------------------------------------------------------------------- *)
    typPayloadOut.liTimestamp := TO_LINT(TIME_TO_LTIME(TIME()));
    typPayloadOut.usiSeq := TO_USINT(uiSeqCounter);
    
    (* ----------------------------------------------------------------------
       Time Base for Waveform Generation
       ---------------------------------------------------------------------- *)
    // Convert sequence counter to time-based value (assuming ~100ms cycle time)
    rTimeSeconds := UINT_TO_REAL(uiSeqCounter) * 0.1;  // Approximate time in seconds
    
    (* ----------------------------------------------------------------------
       METRIC 0: Protocol Version (Static)
       ---------------------------------------------------------------------- *)
    typPayloadOut.atypMetrics[0].sName := 'Version';
    typPayloadOut.atypMetrics[0].rValue := 42.64;  // Static protocol version
    typPayloadOut.atypMetrics[0].usiTypeID := 9;   // REAL type
    
    (* ----------------------------------------------------------------------
       METRIC 1: GPS Latitude (Sinusoidal Wave - Simulates North/South drift)
       ---------------------------------------------------------------------- *)
    // Base: 43.20123° + amplitude ±0.001° with 60-second period
    typPayloadOut.atypMetrics[1].sName := 'GPS.Latitude';
    typPayloadOut.atypMetrics[1].rValue := 43.20123 + 
                                            0.001 * SIN(rTimeSeconds * 0.1047);  // 2π/60
    typPayloadOut.atypMetrics[1].usiTypeID := 9;  // REAL type
    
    (* ----------------------------------------------------------------------
       METRIC 2: Engine Power (Cosine + Sawtooth - Simulates Load Variation)
       ---------------------------------------------------------------------- *)
    // Base: 1850 kW with ±150 kW cosine variation + 50 kW sawtooth
    typPayloadOut.atypMetrics[2].sName := 'Engine.Power_kW';
    typPayloadOut.atypMetrics[2].rValue := 1850.0 + 
                                            150.0 * COS(rTimeSeconds * 0.0628) +  // 2π/100
                                            50.0 * (TO_INT(rTimeSeconds) MOD 10) / 10.0; // Sawtooth 0-10s
    typPayloadOut.atypMetrics[2].usiTypeID := 9;  // REAL type
    
    (* ----------------------------------------------------------------------
       METRIC 3: GPS Longitude (Cosine Wave - Simulates East/West drift)
       ---------------------------------------------------------------------- *)
    // Base: 7.31234° + amplitude ±0.0015° with 80-second period (phase shifted)
    typPayloadOut.atypMetrics[3].sName := 'GPS.Longitude';
    typPayloadOut.atypMetrics[3].rValue := 7.31234 + 
                                            0.0015 * COS(rTimeSeconds * 0.0785 + 1.57);  // π/2 phase shift
    typPayloadOut.atypMetrics[3].usiTypeID := 9;  // REAL type
    
    (* ----------------------------------------------------------------------
       METRIC 4: Engine RPM (Triangle Wave - Simulates Throttle Changes)
       ---------------------------------------------------------------------- *)
    // Triangle wave between 1200-2400 RPM with 20-second period
    typPayloadOut.atypMetrics[4].sName := 'Engine.RPM';
    IF (UINT_TO_REAL(uiSeqCounter MOD 200) &lt; 100.0) THEN
        // Rising edge: 1200 -&gt; 2400
        typPayloadOut.atypMetrics[4].rValue := 1200.0 + 
                                                1200.0 * UINT_TO_REAL(uiSeqCounter MOD 100) / 100.0;
    ELSE
        // Falling edge: 2400 -&gt; 1200
        typPayloadOut.atypMetrics[4].rValue := 2400.0 - 
                                                1200.0 * UINT_TO_REAL(uiSeqCounter MOD 100) / 100.0;
    END_IF;
    typPayloadOut.atypMetrics[4].usiTypeID := 9;  // REAL type
    
    (* ----------------------------------------------------------------------
       METRIC 5: Battery State of Charge (Exponential Decay + Sine Ripple)
       ---------------------------------------------------------------------- *)
    // Slow discharge from 100% to 75% with ±2% charging ripple
    typPayloadOut.atypMetrics[5].sName := 'Battery.StateOfCharge';
    typPayloadOut.atypMetrics[5].rValue := 100.0 - 
                                            (rTimeSeconds * 0.01) +  // Slow discharge 1%/100s
                                            2.0 * SIN(rTimeSeconds * 0.314);  // Fast ripple 2π/20
    // Clamp between 75-100%
    IF typPayloadOut.atypMetrics[5].rValue &lt; 75.0 THEN
        typPayloadOut.atypMetrics[5].rValue := 75.0;
    ELSIF typPayloadOut.atypMetrics[5].rValue &gt; 100.0 THEN
        typPayloadOut.atypMetrics[5].rValue := 100.0;
    END_IF;
    typPayloadOut.atypMetrics[5].usiTypeID := 9;  // REAL type
    
    (* ----------------------------------------------------------------------
       METRIC 6: Shore Power Connection (Pseudo-Random Toggle)
       ---------------------------------------------------------------------- *)
    // Simulates intermittent shore power connection using sequence-based toggle
    typPayloadOut.atypMetrics[6].sName := 'ShorePower.Connected';
    // Toggle every ~50 counts with pseudo-random behavior
    typPayloadOut.atypMetrics[6].rValue := BOOL_TO_REAL((uiSeqCounter MOD 47) &lt; 23);  // ~50% duty
    typPayloadOut.atypMetrics[6].usiTypeID := 9;  // REAL type
    
    (* ----------------------------------------------------------------------
       METRIC 7: Water Temperature (Slow Sine + Fast Noise)
       ---------------------------------------------------------------------- *)
    // Base: 18.5°C with ±2°C daily variation + ±0.3°C sensor noise
    typPayloadOut.atypMetrics[7].sName := 'Sensors.WaterTemp_C';
    
    // Pseudo-random noise using sequence counter hash
    rNoiseAccum := UINT_TO_REAL((uiSeqCounter * 127 + 31) MOD 100) / 100.0 - 0.5;  // Range: -0.5 to 0.5
    
    typPayloadOut.atypMetrics[7].rValue := 18.5 + 
                                            2.0 * SIN(rTimeSeconds * 0.000727) +  // 24-hour period
                                            0.3 * rNoiseAccum;  // Sensor noise ±0.3°C
    typPayloadOut.atypMetrics[7].usiTypeID := 9;  // REAL type
    
    (* ----------------------------------------------------------------------
       METRIC 8: Wind Speed (Gusty Wind Simulation - Multiple Harmonics)
       ---------------------------------------------------------------------- *)
    // Base wind + slow variation + fast gusts
    typPayloadOut.atypMetrics[8].sName := 'Weather.WindSpeed_kts';
    typPayloadOut.atypMetrics[8].rValue := 12.0 +                           // Base: 12 knots
                                            5.0 * SIN(rTimeSeconds * 0.0314) +  // Slow variation: 200s period
                                            2.0 * COS(rTimeSeconds * 0.628) +   // Fast gusts: 10s period
                                            1.0 * SIN(rTimeSeconds * 1.257);    // Turbulence: 5s period
    // Clamp to realistic values (0-30 knots)
    IF typPayloadOut.atypMetrics[8].rValue &lt; 0.0 THEN
        typPayloadOut.atypMetrics[8].rValue := 0.0;
    ELSIF typPayloadOut.atypMetrics[8].rValue &gt; 30.0 THEN
        typPayloadOut.atypMetrics[8].rValue := 30.0;
    END_IF;
    typPayloadOut.atypMetrics[8].usiTypeID := 9;  // REAL type
    
    (* ----------------------------------------------------------------------
       METRIC 9: Fuel Level (Linear Decay with Step Changes)
       ---------------------------------------------------------------------- *)
    // Simulates fuel consumption with occasional refueling
    typPayloadOut.atypMetrics[9].sName := 'Fuel.Level_Liters';
    
    // Linear decay: 5000L -&gt; 1000L over 400 counts, then reset
    IF (uiSeqCounter MOD 400) = 0 THEN
        typPayloadOut.atypMetrics[9].rValue := 5000.0;  // Refuel event
    ELSE
        typPayloadOut.atypMetrics[9].rValue := 5000.0 - 
                                                (10.0 * UINT_TO_REAL(uiSeqCounter MOD 400));
    END_IF;
    typPayloadOut.atypMetrics[9].usiTypeID := 9;  // REAL type
    
    (* ----------------------------------------------------------------------
       Set Active Metric Count
       ---------------------------------------------------------------------- *)
    typPayloadOut.usiMetricCnt := 10;  // Updated to include all new metrics
    
END_IF

(* ============================================================================
   Waveform Summary:
   - Metric 1: SIN (smooth oscillation - GPS Latitude)
   - Metric 2: COS + Sawtooth (periodic + ramp - Engine Power)
   - Metric 3: COS with phase shift (offset oscillation - GPS Longitude)
   - Metric 4: Triangle wave (symmetric ramp - Engine RPM)
   - Metric 5: Linear + SIN (decay + ripple - Battery SoC)
   - Metric 6: Pseudo-random toggle (binary state - Shore Power)
   - Metric 7: SIN + noise (slow + fast - Water Temperature)
   - Metric 8: Multi-harmonic (complex wind simulation - Wind Speed)
   - Metric 9: Step function (discrete events - Fuel Level)
   ============================================================================ *)</Single>
            <Single Name="LineInfoPersistence" Type="string">b6415b19-fc20-4254-ad30-b3967482ac21_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(* ============================================================================
   Custom Payload Generator with Dynamic Simulation Values
   ============================================================================
   Description:
     Generates realistic, time-varying telemetry data for yacht fleet simulation
     using mathematical functions (sin, cos, sawtooth, noise approximation)
   ============================================================================ 
*)


FUNCTION_BLOCK FbCreateCustomPayload
VAR_INPUT
    xEnable     		: BOOL;
END_VAR
VAR
	uiSeqCounter 	: UINT := 0;
	rTimeSeconds    : REAL;          // Elapsed time in seconds for waveform generation
    rPhaseOffset    : REAL := 0.0;   // Phase offset for variation between yachts
    rNoiseAccum     : REAL := 0.0;   // Pseudo-random noise accumulator
END_VAR
VAR_OUTPUT
    typPayloadOut 		: typMQTTPayload;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">b6415b19-fc20-4254-ad30-b3967482ac21_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">562</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">26f5cb85-b5a7-4f34-b57e-3d80537d74bc</Single>
