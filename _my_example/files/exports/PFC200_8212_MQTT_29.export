	liTimestamp  	: LINT;       					// UNIX Epoch Time in ms
    usiSeq       	: USINT;     				 	// Sequence (0…255 → rollover)
    atypMetrics    	: ARRAY[0..49] OF typMetric; 	// e.g  Metric Values
