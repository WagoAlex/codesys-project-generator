    arMetricMin[129] := 0.0; arMetricMax[129] := 1.0;
    arMetricCenter[129] := 0.0; arMetricAmplitude[129] := 0.0;
    aiWaveformType[129] := 5;
    
    aMetricNames[130] := 'engine_alarm_starboard';
    arMetricMin[130] := 0.0; arMetricMax[130] := 1.0;
    arMetricCenter[130] := 0.0; arMetricAmplitude[130] := 0.0;
    aiWaveformType[130] := 5;
    
    aMetricNames[131] := 'generator_alarm';
    arMetricMin[131] := 0.0; arMetricMax[131] := 1.0;
    arMetricCenter[131] := 0.0; arMetricAmplitude[131] := 0.0;
    aiWaveformType[131] := 5;
    
    aMetricNames[132] := 'gps_alarm';
    arMetricMin[132] := 0.0; arMetricMax[132] := 1.0;
    arMetricCenter[132] := 0.0; arMetricAmplitude[132] := 0.0;
    aiWaveformType[132] := 5;
    
    aMetricNames[133] := 'autopilot_alarm';
    arMetricMin[133] := 0.0; arMetricMax[133] := 1.0;
    arMetricCenter[133] := 0.0; arMetricAmplitude[133] := 0.0;
    aiWaveformType[133] := 5;
    
    aMetricNames[134] := 'bilge_alarm';
    arMetricMin[134] := 0.0; arMetricMax[134] := 1.0;
    arMetricCenter[134] := 0.0; arMetricAmplitude[134] := 0.0;
    aiWaveformType[134] := 5;
    
    aMetricNames[135] := 'custom_metric_1';
    arMetricMin[135] := 0.0; arMetricMax[135] := 1000.0;
    arMetricCenter[135] := 500.0; arMetricAmplitude[135] := 250.0;
    aiWaveformType[135] := 0; arFreqMultiplier[135] := 0.1;
    
    aMetricNames[136] := 'custom_metric_2';
    arMetricMin[136] := -100.0; arMetricMax[136] := 100.0;
    arMetricCenter[136] := 0.0; arMetricAmplitude[136] := 50.0;
    aiWaveformType[136] := 1; arFreqMultiplier[136] := 0.15;
    
    aMetricNames[137] := 'custom_metric_3';
    arMetricMin[137] := 0.0; arMetricMax[137] := 500.0;
    arMetricCenter[137] := 250.0; arMetricAmplitude[137] := 100.0;
    aiWaveformType[137] := 2; arFreqMultiplier[137] := 0.12;
    
    aMetricNames[138] := 'custom_metric_4';
    arMetricMin[138] := 0.0; arMetricMax[138] := 100.0;
    arMetricCenter[138] := 50.0; arMetricAmplitude[138] := 30.0;
    aiWaveformType[138] := 0; arFreqMultiplier[138] := 0.08;
    
    aMetricNames[139] := 'custom_metric_5';
    arMetricMin[139] := 10.0; arMetricMax[139] := 90.0;
    arMetricCenter[139] := 50.0; arMetricAmplitude[139] := 25.0;
    aiWaveformType[139] := 0; arFreqMultiplier[139] := 0.2;
    
    aMetricNames[140] := 'custom_metric_6';
    arMetricMin[140] := 0.0; arMetricMax[140] := 1.0;
    arMetricCenter[140] := 0.5; arMetricAmplitude[140] := 0.3;
    aiWaveformType[140] := 0; arFreqMultiplier[140] := 0.5;
    
    aMetricNames[141] := 'custom_metric_7';
    arMetricMin[141] := 0.0; arMetricMax[141] := 10.0;
    arMetricCenter[141] := 5.0; arMetricAmplitude[141] := 3.0;
    aiWaveformType[141] := 2; arFreqMultiplier[141] := 0.25;
    
    xInitialized := TRUE;
END_IF

(* ----------------------------------------------------------------------------
   Update simulation time and phase
   ---------------------------------------------------------------------------- *)
rSimTime := rSimTime + rTimeBase;
udiSeqCounter := udiSeqCounter + 1;
rPhase := rPhase + (rTimeBase * TWO_PI * 0.1);

(* Wrap phase to prevent overflow *)
IF rPhase &gt; (TWO_PI * 1000.0) THEN
    rPhase := rPhase - (TWO_PI * 1000.0);
END_IF

(* ----------------------------------------------------------------------------
   Generate values for all metrics
   ---------------------------------------------------------------------------- *)
FOR i := 0 TO 141 DO
    IF i &gt; iMetricCount THEN
        rRawValues[i] := 0.0;
        aValuesString[i] := '0.0';
        aMinString[i] := '0.0';
        aMaxString[i] := '0.0';
    ELSE
        (* Generate random number using internal LCG PRNG *)
        udiPRNGState := udiPRNGState * 1664525 + 1013904223;
        udiTmp := udiPRNGState AND 16#7FFFFFFF;
        rRandom := TO_REAL(udiTmp) / TO_REAL(16#7FFFFFFF);
        
        (* Calculate base waveform value based on type *)
        CASE aiWaveformType[i] OF
            0:  (* Sine wave *)
                rBaseValue := arMetricCenter[i] + 
                    arMetricAmplitude[i] * SIN(rPhase * arFreqMultiplier[i] + arPhaseOffset[i]);
                
            1:  (* Cosine wave *)
                rBaseValue := arMetricCenter[i] + 
                    arMetricAmplitude[i] * COS(rPhase * arFreqMultiplier[i] + arPhaseOffset[i]);
                
            2:  (* Triangle wave - inline calculation *)
                rTriTemp := rPhase * arFreqMultiplier[i] + arPhaseOffset[i];
                (* Normalize to 0..2*PI *)
                WHILE rTriTemp &gt;= TWO_PI DO
                    rTriTemp := rTriTemp - TWO_PI;
                END_WHILE
                WHILE rTriTemp &lt; 0.0 DO
                    rTriTemp := rTriTemp + TWO_PI;
                END_WHILE
                (* Generate triangle: -1 to +1 *)
                IF rTriTemp &lt; PI THEN
                    rNormAngle := -1.0 + (2.0 * rTriTemp / PI);
                ELSE
                    rNormAngle := 3.0 - (2.0 * rTriTemp / PI);
                END_IF
                rBaseValue := arMetricCenter[i] + arMetricAmplitude[i] * rNormAngle;
                
            3:  (* Ramp / sawtooth *)
                rTriTemp := rSimTime * arFreqMultiplier[i] * 100.0;
                rTriTemp := rTriTemp - TRUNC(rTriTemp / (arMetricMax[i] - arMetricMin[i])) * (arMetricMax[i] - arMetricMin[i]);
                rBaseValue := arMetricMin[i] + rTriTemp;
                
            4:  (* Toggle digital on/off *)
                IF SIN(rPhase * arFreqMultiplier[i] + arPhaseOffset[i]) &gt; 0.0 THEN
                    rBaseValue := 1.0;
                ELSE
                    rBaseValue := 0.0;
                END_IF
                
            5:  (* Constant with noise only *)
                rBaseValue := arMetricCenter[i];
                
            ELSE
                rBaseValue := arMetricCenter[i];
        END_CASE
        
        (* Apply noise - skip for toggle signals *)
        IF aiWaveformType[i] &lt;&gt; 4 THEN
            rNoise := (rRandom - 0.5) * 2.0 * rGlobalNoiseLevel * (arMetricMax[i] - arMetricMin[i]);
            rBaseValue := rBaseValue + rNoise;
        END_IF
        
        (* Apply anomaly if enabled *)
        rAnomalyOffset := 0.0;
        IF axAnomalySimulateArray[i] THEN
            (* Get new random for anomaly type *)
            udiPRNGState := udiPRNGState * 1664525 + 1013904223;
            udiTmp := udiPRNGState AND 16#7FFFFFFF;
            rRandom := TO_REAL(udiTmp) / TO_REAL(16#7FFFFFFF);
            
            IF rRandom &lt; 0.33 THEN
                (* Spike anomaly *)
                udiPRNGState := udiPRNGState * 1664525 + 1013904223;
                udiTmp := udiPRNGState AND 16#7FFFFFFF;
                rAnomalyOffset := (TO_REAL(udiTmp) / TO_REAL(16#7FFFFFFF) - 0.5) * 4.0 * arMetricAmplitude[i];
                axAnomalyFreezeActive[i] := FALSE;
                
            ELSIF rRandom &lt; 0.66 THEN
                (* Offset jump *)
                IF NOT axAnomalyFreezeActive[i] THEN
                    udiPRNGState := udiPRNGState * 1664525 + 1013904223;
                    udiTmp := udiPRNGState AND 16#7FFFFFFF;
                    arAnomalyFreezeValue[i] := (TO_REAL(udiTmp) / TO_REAL(16#7FFFFFFF) - 0.5) * 2.0 * arMetricAmplitude[i];
                    axAnomalyFreezeActive[i] := TRUE;
                END_IF
                rAnomalyOffset := arAnomalyFreezeValue[i];
                
            ELSE
                (* Freeze anomaly *)
                IF NOT axAnomalyFreezeActive[i] THEN
                    arAnomalyFreezeValue[i] := rBaseValue;
                    axAnomalyFreezeActive[i] := TRUE;
                END_IF
                rBaseValue := arAnomalyFreezeValue[i];
                rAnomalyOffset := 0.0;
            END_IF
        ELSE
            axAnomalyFreezeActive[i] := FALSE;
        END_IF
        
        (* Calculate final value *)
        rFinalValue := rBaseValue + rAnomalyOffset;
        
        (* Clamp to bounds *)
        IF rFinalValue &lt; arMetricMin[i] THEN
            rFinalValue := arMetricMin[i];
        ELSIF rFinalValue &gt; arMetricMax[i] THEN
            rFinalValue := arMetricMax[i];
        END_IF
        
        (* Store raw value *)
        rRawValues[i] := rFinalValue;
        
        (* Convert to string with appropriate precision *)
        rAbsVal := ABS(rFinalValue);
        liIntPart := TRUNC(rFinalValue);
        
        IF rAbsVal &gt;= 1000.0 THEN
            aValuesString[i] := REAL_TO_STRING(rFinalValue);
			aValuesString20[i] := REAL_TO_STRING(rFinalValue);
        ELSIF rAbsVal &gt;= 1.0 THEN
            (* 2 decimal places *)
            iFracPart := TO_INT((rAbsVal - ABS(TO_REAL(liIntPart))) * 100.0);
            sTemp := LINT_TO_STRING(liIntPart);
            sTemp := CONCAT(sTemp, '.');
            IF iFracPart &lt; 10 THEN
                sTemp := CONCAT(sTemp, '0');
            END_IF
            sTemp := CONCAT(sTemp, INT_TO_STRING(iFracPart));
            aValuesString[i] := sTemp;
			aValuesString20[i] := sTemp;
        ELSE
            (* 3 decimal places for small values *)
            iFracPart := TO_INT(rAbsVal * 1000.0);
            IF rFinalValue &lt; 0.0 THEN
                sTemp := '-0.';
            ELSE
                sTemp := '0.';
            END_IF
            IF iFracPart &lt; 10 THEN
                sTemp := CONCAT(sTemp, '00');
            ELSIF iFracPart &lt; 100 THEN
                sTemp := CONCAT(sTemp, '0');
            END_IF
            sTemp := CONCAT(sTemp, INT_TO_STRING(iFracPart));
            aValuesString[i] := sTemp;
			aValuesString20[i] := sTemp;
        END_IF
        
        (* Set min/max strings *)
        aMinString[i] := REAL_TO_STRING(arMetricMin[i]);
        aMaxString[i] := REAL_TO_STRING(arMetricMax[i]);
    END_IF
END_FOR

(* Special handling for timestamp index 0 *)
rRawValues[0] := rSimTime * 1000.0;
aValuesString[0] := LREAL_TO_STRING(TRUNC(rSimTime * 1000.0));
aValuesString20[0] := LREAL_TO_STRING(TRUNC(rSimTime * 1000.0));

(* Special handling for sequence index 1 *)
rRawValues[1] := TO_REAL(udiSeqCounter);
aValuesString[1] := UDINT_TO_STRING(udiSeqCounter);
aValuesString20[1] := UDINT_TO_STRING(udiSeqCounter);

(* Set output flags *)
bValid := TRUE;
bParsingError := FALSE;</Single>
