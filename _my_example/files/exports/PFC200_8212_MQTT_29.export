          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(* ============================================================================
   FB_SimulateAnalyticsMetrics
   IEC 61131-3 Structured Text Function Block
   Simulates realistic yacht telemetry metrics with noise and anomaly injection
   Compatible with CODESYS / WAGO PLC environments
   
   Author: Generated for Besecke  telemetry simulation
   Version: 1.0
   ============================================================================ *)



FUNCTION_BLOCK FB_SimulateAnalyticsMetrics
VAR_INPUT
    xEnable                 : BOOL;                                              (* Enable simulation *)

    axAnomalySimulateArray  : ARRAY[0..141] OF BOOL;                             (* TRUE = anomaly active *)
    rGlobalNoiseLevel       : REAL := 0.05;                                      (* Max noise amplitude 0..1 *)
    rTimeBase               : REAL := 0.1;                                       (* Base time step in seconds *)
END_VAR

VAR_OUTPUT
    aValuesString20         : ARRAY[0..141] OF STRING(20);                       	(* Simulated values as strings max 20 char for Wago Lib Analytics*)
	aValuesString			: ARRAY[0..141] OF STRING(JSON_MAX_PARAMETER_STRING);   (* Simulated values as strings max JSON_MAX_PARAMETER_STRING*)     
    aMinString              : ARRAY[0..141] OF STRING(20);                       (* Min values as strings *)
    aMaxString              : ARRAY[0..141] OF STRING(20);                       (* Max values as strings *)
    aMetricNames            : ARRAY[0..141] OF STRING(64);                       (* Metric names *)
    bValid                  : BOOL;                                              (* TRUE = values valid *)
    bParsingError           : BOOL;                                              (* Always FALSE *)
    rRawValues              : ARRAY[0..141] OF REAL;                             (* Raw real values *)
END_VAR

VAR
	iMetricCount            : UINT := 141;                                       (* Number of metrics 0..141 *)
    (* PRNG state - Linear Congruential Generator *)
    udiPRNGState            : UDINT := 4264141;
    
    (* Phase accumulator *)
    rPhase                  : REAL := 0.0;
    
    (* Simulation time *)
    rSimTime                : REAL := 0.0;
    udiSeqCounter           : UDINT := 0;
    
    (* Loop and temp variables *)
    i                       : UINT;
    rBaseValue              : REAL;
    rNoise                  : REAL;
    rAnomalyOffset          : REAL;
    rFinalValue             : REAL;
    rRandom                 : REAL;
    rTriTemp                : REAL;
    rNormAngle              : REAL;
    udiTmp                  : UDINT;
    
    (* String conversion temps *)
    sTemp                   : STRING(20);
    rAbsVal                 : REAL;
    liIntPart               : LINT;
    iFracPart               : INT;
    
    (* Constants *)
    PI                      : REAL := 3.14159265358979;
    TWO_PI                  : REAL := 6.28318530717959;
    
    (* Metric configuration arrays *)
    arMetricMin             : ARRAY[0..141] OF REAL;
    arMetricMax             : ARRAY[0..141] OF REAL;
    arMetricCenter          : ARRAY[0..141] OF REAL;
    arMetricAmplitude       : ARRAY[0..141] OF REAL;
    aiWaveformType          : ARRAY[0..141] OF INT;    (* 0=sin,1=cos,2=tri,3=ramp,4=toggle,5=const *)
    arPhaseOffset           : ARRAY[0..141] OF REAL;
    arFreqMultiplier        : ARRAY[0..141] OF REAL;
    
    (* Anomaly state *)
    arAnomalyFreezeValue    : ARRAY[0..141] OF REAL;
    axAnomalyFreezeActive   : ARRAY[0..141] OF BOOL;
    
    (* Init flag *)
    xInitialized            : BOOL := FALSE;
END_VAR
</Single>
