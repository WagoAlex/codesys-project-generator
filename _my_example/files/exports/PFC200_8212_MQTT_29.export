            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM Prg_MQTT
VAR
    oFbSubscribeMQTT                        : FbSubscribeMQTT;
    oJsonParser                             : WagoAppJSON.Fb_JSON_ParseAndModify;
    oGetValue                               : WagoAppJSON.typJSON_Pointer;
    
    xSubscribe                              : BOOL := TRUE;
    sTopic                                  : STRING(255) := 'inference/yolov5m-results';
    
    eQoS                                    : WagoAppCloud.eQualityOfService := WagoAppCloud.eQualityOfService.QoS0;
    aPayloadData                            : ARRAY[0..UPPERBOUND] OF BYTE;
    
    xBusy, xError, xDataReceived, xDataTruncated : BOOL;
    
    dwRxNBytes                              : DWORD;
    sReceivedTopic                          : STRING(255);
    oStatus                                 : WagoAppCloud.WagoSysErrorBase.FbResult;
    
    // State
    bState                                  : eHelmetState := eHelmetState.idle;
    
    // JSON message as string
    sJsonMessage                            : STRING(200);
    
    // JSON parsing triggers
    xTriggerParse                           : BOOL;
    xTriggerGetTimestamp                    : BOOL;
    xTriggerGetClass                        : BOOL;
    xTriggerGetConfidence                   : BOOL;
    
    // Detection data
    sJsonPointer                            : STRING(255);
    sDetectionClass                         : STRING(50);
    sConfidenceValue                        : STRING(20);
    rConfidence                             : REAL;
    
    // Timestamp monitoring
    sTimestampValue                         : STRING(20);
    liTimestampMs                           : LINT;          // Timestamp in milliseconds
    dtLastDetectionUTC , dtLastDetectionCET, dtLastDetectionCEST    
						                    : DT;            // Last detection time
    udiUnixTimestamp                        : UDINT;         // Unix timestamp in seconds
    
    // State machine
    bParseState                             : INT := 0;
    
    // Helper variables
    xParsingDone                            : BOOL;
    xParseData                              : BOOL;
    xLowConfidence                          : BOOL;
    
    // LED outputs
    LED_White                               : BOOL;
    LED_Blue                                : BOOL;
    LED_Red                                 : BOOL;
	xWrongType								: BOOL;
	
	
	oFbCustomPayload						: FbCreateCustomPayload;
	aMQTTClient								: ARRAY[ciFIRST_INDEX..ciLAST_INDEX] OF MQTT.MQTTClient;
	aMQTTPublish							: ARRAY[ciFIRST_INDEX..ciLAST_INDEX] OF MQTT.MQTTPublish;
	
	aMQTTClient2							: ARRAY[ciFIRST_INDEX..ciLAST_INDEX] OF MQTT.MQTTClient;
	aMQTTPublishComplex						: ARRAY[ciFIRST_INDEX..ciLAST_INDEX] OF MQTT.MQTTPublish;
	
	xExecutePublishMqtt						: ARRAY [ciFIRST_INDEX..ciLAST_INDEX] OF BOOL;


	index									: INT := 1;
	xTrigger_MQTT							: BOOL;
	sIndexTopic								: STRING(JSON_MAX_PARAMETER_STRING) := 'default';
	sIndexTopic2								: STRING(JSON_MAX_PARAMETER_STRING) := 'default';
	xEnable									: BOOL := TRUE;
	

	udiTimeOut								: UDINT := 60;
	wsTopic									: WSTRING(1024);
	wsTopic2								: WSTRING(1024);
	
	sPayload_FormatX						: STRING(512);
	xFirstCycle								: BOOL := TRUE;
	
	
	sJSON_BaseFrame : STRING(JSON_MAX_STRING) := '
	{
		"timestamp": #Parameter,
		"seq": #Parameter,
		"MetricCnt": #Parameter,
		"MetricValue": #Parameter,
		"MetricName": "#Parameter",
		"MetricValue2": #Parameter,
		"MetricName2": "#Parameter",
		"MetricValue3": #Parameter,
		"MetricName3": "#Parameter"
	}';
     sValueArray							: ARRAY[0..8] OF STRING(JSON_MAX_PARAMETER_STRING);
	 oFb_JSON_Writer_02 					: Fb_JSON_Writer_02;

	xTriggerJSONWriter						: BOOL := TRUE;
	sPayload_WAGO_JSON						: STRING(JSON_MAX_STRING);
	
	
	xExecute: BOOL := TRUE;
	oTP1: TP;
	oTP2: TP;
	tPublishTime: TIME := TIME#10ms;
	
	
	
	pbPayloadPtr: POINTER TO STRING(JSON_MAX_STRING);
	udiPayloadLen: UDINT;
	pbPayloadPtr2: POINTER TO STRING(16384);
	udiPayloadLen2: UDINT;
	udiLenTmp: UDINT;
END_VAR

VAR CONSTANT
    CONFIDENCE_THRESHOLD                    : REAL := 0.7;
    UPPERBOUND                              : INT := 200;
	cPublishFBs								: INT := 6;

	sHostname          						: STRING := '192.168.2.165'; // or broker.wago.local
    uiPort             						: UINT := 1883;
	ciFIRST_INDEX							: INT := 1;
	ciLAST_INDEX							: INT := 6;
END_VAR</Single>
