            <Single Name="TextBlobForSerialisation" Type="string">GVL.typCurrentTime:=FuGetLocalTimeComponents();
GVL.dtCurrentTime:=FuGetLocalDateAndTime();


ACT_Publish();
ACT_Subscribe();
(*
Erstelle einen weiteren JSON_BaseFrame mit dem namen JSON_BaseFrameBesecke im UNS ISA 95 format für eine Yacht mit 142 sinnvollen Datenpunkten und ein passendes sValueArray							: ARRAY[0..8] OF STRING(JSON_MAX_PARAMETER_STRING);
*)

</Single>
