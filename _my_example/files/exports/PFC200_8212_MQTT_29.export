      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">65b158fe-5d27-46cf-ab2e-9de4858589b8</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">SPS-Logik</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">Taskkonfiguration</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">67e8e549-fe66-4f99-98aa-2965d31a1aeb</Single>
        <Single Name="ParentGuid" Type="System.Guid">bf9d5ced-951f-4b29-8014-e690fcb6ec9e</Single>
        <Single Name="Name" Type="string">ACT_Publish</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">8ac092e5-3128-4e26-9e7e-11016c6684f2</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639008747846063883</Single>
      </Single>
      <Single Name="Object" Type="{8ac092e5-3128-4e26-9e7e-11016c6684f2}" Method="IArchivable">
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(* ============================================================================
   Payload Generation and MQTT Publishing for Yacht Fleet Monitoring
   ============================================================================ 
   Description: 
     - Generates telemetry payload containing timestamp, sequence number, and metrics 
     - Creates JSON-formatted payloads using two methods (WagoAppJSON and Format9) 
     - Publishes data to MQTT broker for multiple yacht clients 
   
   Author: Alexander Fugmann
   Date: 2025-11-21
   Version: 1.0
   ============================================================================ 
*)

	oTP1(IN := NOT oTP2.Q, PT := tPublishTime);   // Timer 1: ON phasen)
	xExecute := oTP1.Q;
	oTP2(IN := NOT oTP1.Q, PT := tPublishTime);   // Timer 2: OFF phase 
// Publish only when client is connected to broker


(* --------------------------------------------------------------------------
   SECTION 1: Payload Data Preparation
   -------------------------------------------------------------------------- *)
// Update custom payload structure with current sensor/metric values
oFbCustomPayload(xEnable := xEnable);

// Populate parameter value array for JSON template substitution
// Note: Array indices 0-8 correspond to #Parameter placeholders in sJSON_BaseFrame
sValueArray[0] := LINT_TO_STRING(oFbCustomPayload.typPayloadOut.liTimestamp);      // Unix timestamp (ms)
sValueArray[1] := INT_TO_STRING(oFbCustomPayload.typPayloadOut.usiSeq);            // Sequence number
sValueArray[2] := INT_TO_STRING(oFbCustomPayload.typPayloadOut.usiMetricCnt);      // Total metric count
sValueArray[3] := REAL_TO_STRING(oFbCustomPayload.typPayloadOut.atypMetrics[1].rValue);  // Metric 1 value
sValueArray[4] := oFbCustomPayload.typPayloadOut.atypMetrics[1].sName;             // Metric 1 name
sValueArray[5] := REAL_TO_STRING(oFbCustomPayload.typPayloadOut.atypMetrics[2].rValue);  // Metric 2 value
sValueArray[6] := oFbCustomPayload.typPayloadOut.atypMetrics[2].sName;             // Metric 2 name
sValueArray[7] := REAL_TO_STRING(oFbCustomPayload.typPayloadOut.atypMetrics[3].rValue);  // Metric 3 value
sValueArray[8] := oFbCustomPayload.typPayloadOut.atypMetrics[3].sName;             // Metric 3 name

(* --------------------------------------------------------------------------
   SECTION 2: JSON Payload Generation (Method 1 - WagoAppJSON)
   -------------------------------------------------------------------------- *)
// Trigger JSON writer if no error condition exists
IF NOT oFb_JSON_Writer_02.xError THEN 
    xTriggerJSONWriter := TRUE;
END_IF

// Generate JSON string by substituting #Parameter placeholders with actual values
oFb_JSON_Writer_02(
    sJSON_BaseFrame    := sJSON_BaseFrame,      // Template with #Parameter placeholders
    aParameterValues   := sValueArray,          // Array of substitution values
    xTrigger           := xTriggerJSONWriter,   // Execution trigger
    sOutput            := sPayload_WAGO_JSON    // Resulting JSON string
);

(* --------------------------------------------------------------------------
   SECTION 3: JSON Payload Generation (Method 2 - Format9)
   -------------------------------------------------------------------------- *)
// Alternative method using Format9 for direct JSON string formatting
// Format specifiers: %li=LINT, %i=INT, %.2f=REAL (2 decimals), %s=STRING
sPayload_FormatX := Format9(
    sFormat := '{"timestamp":%li,"seq":%i,"MetricCnt":%i,"MetricValue":%.2f,"MetricName":"%s","MetricValue2":%.2f,"MetricName2":"%s","MetricValue3":%.2f,"MetricName3":"%s"}',
    p1 := ADR(oFbCustomPayload.typPayloadOut.liTimestamp),          // Pointer to timestamp
    p2 := ADR(oFbCustomPayload.typPayloadOut.usiSeq),               // Pointer to sequence
    p3 := ADR(oFbCustomPayload.typPayloadOut.usiMetricCnt),         // Pointer to metric count
    p4 := ADR(oFbCustomPayload.typPayloadOut.atypMetrics[1].rValue), // Pointer to metric 1 value
    p5 := ADR(oFbCustomPayload.typPayloadOut.atypMetrics[1].sName),  // Pointer to metric 1 name
    p6 := ADR(oFbCustomPayload.typPayloadOut.atypMetrics[2].rValue), // Pointer to metric 2 value
    p7 := ADR(oFbCustomPayload.typPayloadOut.atypMetrics[2].sName),  // Pointer to metric 2 name
    p8 := ADR(oFbCustomPayload.typPayloadOut.atypMetrics[3].rValue), // Pointer to metric 3 value
    p9 := ADR(oFbCustomPayload.typPayloadOut.atypMetrics[3].sName)   // Pointer to metric 3 name
);

(* --------------------------------------------------------------------------
   SECTION 4: MQTT Client Management and Publishing
   -------------------------------------------------------------------------- *)
   IF xFirstCycle THEN 
	   xFirstCycle:=FALSE;
		FOR index := ciFIRST_INDEX TO ciLAST_INDEX DO
		   
			
			sIndexTopic := Format1(sFormat := 'yachtFleet/%i/data', p1 := ADR(index));
			wsTopic := TO_WSTRING(sIndexTopic);  // Convert to WSTRING for MQTT library
			
			sIndexTopic2 := Format1(sFormat := 'yachtFleetDetailed/%i/data', p1 := ADR(index));
			wsTopic2 := TO_WSTRING(sIndexTopic2);  // Convert to WSTRING for MQTT library
			
			// Configure and maintain MQTT client connection
			aMQTTClient[index](
				xEnable            := xEnable,              // Master enable for client
				sHostname          := sHostname,            // MQTT broker hostname/IP
				uiPort             := uiPort,               // MQTT broker port (typically 1883)
				sClientId          := CONCAT('YachtClient_', INT_TO_STRING(index)),  // Unique client ID
				xCleanSession      := TRUE,                 // Start with clean session (no persistent state)
				uiKeepAlive        := 60,                   // Keep-alive interval in seconds
				xUseTLS            := FALSE,                // TLS/SSL encryption disabled (set TRUE for production)
				xWillRetain        := FALSE,                // Last Will message not retained
				pbWillMessage      := 0,                    // No Last Will message configured
				uiWillMessageSize  := 0                     // Last Will message size
			);
			aMQTTClient2[index](
				xEnable            := xEnable,              // Master enable for client
				sHostname          := sHostname,            // MQTT broker hostname/IP
				uiPort             := uiPort,               // MQTT broker port (typically 1883)
				sClientId          := CONCAT('YachtClient2_', INT_TO_STRING(index)),  // Unique client ID
				xCleanSession      := TRUE,                 // Start with clean session (no persistent state)
				uiKeepAlive        := 60,                   // Keep-alive interval in seconds
				xUseTLS            := FALSE,                // TLS/SSL encryption disabled (set TRUE for production)
				xWillRetain        := FALSE,                // Last Will message not retained
				pbWillMessage      := 0,                    // No Last Will message configured
				uiWillMessageSize  := 0                     // Last Will message size
			);
		END_FOR
	
  END_IF
// Iterate through all yacht clients in the fleet
FOR index := ciFIRST_INDEX TO ciLAST_INDEX DO
    
    // Generate unique MQTT topic for each yacht: "yachtFleet/&lt;index&gt;/data"

    
    (* ----------------------------------------------------------------------
       SECTION 4.1: Publish Logic with Timing Control
       ---------------------------------------------------------------------- *)

   IF aMQTTClient[index].xConnectedToBroker THEN

    // Pulse generator for periodic publishing (alternating timers create continuous pulse train)



	// Pointer und Länge für den kleineren Payload
	pbPayloadPtr := ADR(sPayload_WAGO_JSON);
	udiPayloadLen := WagoSysString.strnlen(p := ADR(sPayload_WAGO_JSON), udiSize := SIZEOF(sPayload_WAGO_JSON));


	
	aMQTTPublish[index](
		xExecute       := xExecute,
		udiTimeOut     := udiTimeOut,
		eQoS           := MQTT.MQTT_QOS.QoS0,
		xRetain        := FALSE,
		pbPayload      := pbPayloadPtr,
		udiPayloadSize := udiPayloadLen,
		mqttClient     := aMQTTClient[index],
		wsTopicName    := wsTopic,
		eMQTTError     =&gt; 
	);
	


	// Pointer und Länge für das große GVL-Feld
	//MEMUtils.MemSet(pbyBuffer := ADR(sPayload_WAGO_JSON),byValue := 0,dwSize := SIZEOF(sPayload_WAGO_JSON));
	pbPayloadPtr2 := ADR(GVL_Fast.sJSONMetricOutput);
	udiPayloadLen2 := WagoSysString.strnlen(p := ADR(GVL_Fast.sJSONMetricOutput), udiSize := SIZEOF(GVL_Fast.sJSONMetricOutput));
	 

	aMQTTPublishComplex[index](
		xExecute       := xExecute,
		udiTimeOut     := udiTimeOut,
		eQoS           := MQTT.MQTT_QOS.QoS0,
		xRetain        := FALSE,
		pbPayload      := pbPayloadPtr2,
		udiPayloadSize := udiPayloadLen2,
		mqttClient     := aMQTTClient2[index],
		wsTopicName    := wsTopic2,
		eMQTTError     =&gt; 
	);

	END_IF
    
END_FOR

(* ============================================================================
   END OF PUBLISHING ROUTINE
   ============================================================================ *)</Single>
            <Single Name="LineInfoPersistence" Type="string">67e8e549-fe66-4f99-98aa-2965d31a1aeb_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">942</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">bf9d5ced-951f-4b29-8014-e690fcb6ec9e</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">SPS-Logik</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">MQTT Publish</Single>
        <Single Type="string">Prg_MQTT</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">a28a90d4-b4b6-4296-8693-36d4298043d8</Single>
        <Single Name="ParentGuid" Type="System.Guid">bf9d5ced-951f-4b29-8014-e690fcb6ec9e</Single>
        <Single Name="Name" Type="string">ACT_Subscribe</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">8ac092e5-3128-4e26-9e7e-11016c6684f2</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">638993105172337287</Single>
      </Single>
      <Single Name="Object" Type="{8ac092e5-3128-4e26-9e7e-11016c6684f2}" Method="IArchivable">
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
// ============================================
// MQTT Subscribe Function Block
// ============================================
oFbSubscribeMQTT(
    xSubscribe          := xSubscribe, 
    sTopic              := sTopic, 
    eQoS                := eQoS, 
    aPayloadData        := aPayloadData, 
    xBusy               =&gt; xBusy, 
    xError              =&gt; xError, 
    oStatus             =&gt; oStatus, 
    xDataReceived       =&gt; xDataReceived, 
    dwRxNBytes          =&gt; dwRxNBytes, 
    xDataTruncated      =&gt; xDataTruncated, 
    sReceivedTopic      =&gt; sReceivedTopic
);


// ============================================
// Process received MQTT data
// ============================================
IF xDataReceived THEN
    // Copy byte array to string using MemCopySecure 
    MemCopySecure(
        pDest           := ADR(sJsonMessage),
        udiDestSize     := SIZEOF(sJsonMessage),
        pSource         := ADR(aPayloadData),
        udiSourceSize   := dwRxNBytes,
        bPadding        := 0
    );
    
    xDataReceived := FALSE;
    xTriggerParse := TRUE;
    bParseState := 0;
END_IF;

// ============================================
// JSON Parsing State Machine
// ============================================
CASE bParseState OF
    
    0: // Idle state
        IF xTriggerParse THEN
            bParseState := 1;
            xTriggerParse := TRUE;  // Set trigger for parsing
        END_IF;
    
    1: // Parse JSON structure
        oJsonParser(
            pData           := ADR(aPayloadData),
            udiSizeData     := dwRxNBytes,
            xTrigger        := xTriggerParse
        );
        
        // Check if parsing is complete
        IF oJsonParser.xDone THEN
            xTriggerParse := FALSE;  // Reset trigger
            bParseState := 2;  // Move to get timestamp
        ELSIF oJsonParser.xError THEN
            xTriggerParse := FALSE;  // Reset trigger
            bParseState := 0;  // Reset on error
        END_IF;
    
    2: // Get timestamp
        sJsonPointer := '/timestamp';
        
        IF NOT xTriggerGetTimestamp THEN
            xTriggerGetTimestamp := TRUE;  // Trigger method once
        END_IF;
        
        oGetValue := oJsonParser.GetValueByPath(
            sPointer    := sJsonPointer,
            xTrigger    := xTriggerGetTimestamp
        );
        
        IF oGetValue.eReturn = 0 THEN  // 0 = Values are valid
            IF oGetValue.eType = WagoAppJSON.JSON_NUMBER THEN
                sTimestampValue := oGetValue.sValue;
                liTimestampMs := STRING_TO_LINT(sTimestampValue); //TimeStamp conversation
                udiUnixTimestamp := LINT_TO_UDINT(liTimestampMs / 1000);
                dtLastDetectionUTC := UDINT_TO_DT(udiUnixTimestamp);
				dtLastDetectionCET := UDINT_TO_DT(udiUnixTimestamp+7200);
				dtLastDetectionCEST :=UDINT_TO_DT(udiUnixTimestamp+10800);
            END_IF;
            xTriggerGetTimestamp := FALSE;
            bParseState := 3;  // Move to get class
        ELSIF oGetValue.eReturn &lt; 0 THEN  // &lt;0 = Values invalid (error)
            xTriggerGetTimestamp := FALSE;
            bParseState := 3;  // Continue anyway
        END_IF;
    
    3: // Get detection class from first detection
        sJsonPointer := '/detections/0/class';
        
        IF NOT xTriggerGetClass THEN
            xTriggerGetClass := TRUE;  // Trigger method once
        END_IF;
        
        oGetValue := oJsonParser.GetValueByPath(
            sPointer    := sJsonPointer,
            xTrigger    := xTriggerGetClass
        );
        
        IF oGetValue.eReturn = 0 THEN  // 0 = Values are valid
            IF oGetValue.eType = WagoAppJSON.JSON_STRING THEN
                sDetectionClass := oGetValue.sValue;
                xTriggerGetClass := FALSE;
                bParseState := 4;  // Move to get confidence
            ELSE
                xTriggerGetClass := FALSE;
                xLowConfidence := TRUE;
                bParseState := 0;
            END_IF;
        ELSIF oGetValue.eReturn &lt; 0 THEN  // &lt;0 = Values invalid (error)
            xTriggerGetClass := FALSE;
            xLowConfidence := TRUE;
            bParseState := 0;
        END_IF;
    
    4: // Get confidence from first detection
        sJsonPointer := '/detections/0/confidence';
        
        IF NOT xTriggerGetConfidence THEN
            xTriggerGetConfidence := TRUE;  // Trigger method once
        END_IF;
        
        oGetValue := oJsonParser.GetValueByPath(
            sPointer    := sJsonPointer,
            xTrigger    := xTriggerGetConfidence
        );
        
        IF oGetValue.eReturn = 0 THEN  // 0 = Values are valid
            IF oGetValue.eType = WagoAppJSON.JSON_NUMBER THEN
                sConfidenceValue := oGetValue.sValue;
                rConfidence := STRING_TO_REAL(sConfidenceValue);
                xTriggerGetConfidence := FALSE;
                bParseState := 5;  // Move to update state
            ELSE
                xTriggerGetConfidence := FALSE;
                xLowConfidence := TRUE;
                bParseState := 0;
            END_IF;
        ELSIF oGetValue.eReturn &lt; 0 THEN  // &lt;0 = Values invalid (error)
            xTriggerGetConfidence := FALSE;
            xLowConfidence := TRUE;
            bParseState := 0;
        END_IF;
    
    5: // Update helmet state based on detection
        IF rConfidence &gt;= CONFIDENCE_THRESHOLD THEN
            xLowConfidence := FALSE;
            
            IF sDetectionClass = 'white helmet' THEN
                bState := eHelmetState.white_helmet;
            ELSIF sDetectionClass = 'blue helmet' THEN
                bState := eHelmetState.blue_helmet;
            ELSIF sDetectionClass = 'head' THEN
                bState := eHelmetState.head;
            ELSE
                bState := eHelmetState.idle;
            END_IF;
        ELSE
            xLowConfidence := TRUE;
        END_IF;
        
        bParseState := 0;  // Return to idle
        
ELSE
    bParseState := 0;  // Safety: return to idle
END_CASE;

// ============================================
// LED Control State Machine
// ============================================
IF xLowConfidence or xWrongType THEN
    // Low confidence or error - all LEDs off (default)
    LED_White := FALSE;
    LED_Blue  := FALSE;
    LED_Red   := FALSE;
ELSE
    // Normal operation - control LEDs based on state
    CASE bState OF
        eHelmetState.white_helmet:
            LED_White := TRUE;
            LED_Blue  := FALSE;
            LED_Red   := FALSE;

        eHelmetState.blue_helmet:
            LED_White := FALSE;
            LED_Blue  := TRUE;
            LED_Red   := FALSE;

        eHelmetState.head:
            LED_White := FALSE;
            LED_Blue  := FALSE;
            LED_Red   := TRUE;
    ELSE
        // Default or error handling (idle state)
        LED_White := FALSE;
        LED_Blue  := FALSE;
        LED_Red   := FALSE;
    END_CASE;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">a28a90d4-b4b6-4296-8693-36d4298043d8_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">205</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">bf9d5ced-951f-4b29-8014-e690fcb6ec9e</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">SPS-Logik</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">MQTT Publish</Single>
        <Single Type="string">Prg_MQTT</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
  </List2>
  <Single Name="ProfileName" Type="string">CODESYS V3.5 SP21 Patch 1</Single>
