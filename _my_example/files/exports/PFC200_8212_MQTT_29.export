            <Single Name="TextBlobForSerialisation" Type="string">(* ============================================================================
   MAIN LOGIC
   ============================================================================ *)

IF NOT xEnable THEN
    bValid := FALSE;
    RETURN;
END_IF

(* ----------------------------------------------------------------------------
   Initialize metric configurations on first run
   ---------------------------------------------------------------------------- *)
IF NOT xInitialized THEN
    FOR i := 0 TO 141 DO
        arMetricMin[i] := 0.0;
        arMetricMax[i] := 100.0;
        arMetricCenter[i] := 50.0;
        arMetricAmplitude[i] := 25.0;
        aiWaveformType[i] := 0;
        arPhaseOffset[i] := TO_REAL(i) * 0.1;
        arFreqMultiplier[i] := 1.0;
        axAnomalyFreezeActive[i] := FALSE;
        arAnomalyFreezeValue[i] := 0.0;
    END_FOR
    
    (* === Configure yacht telemetry metrics === *)
    
    (* Index 0: timestamp *)
    aMetricNames[0] := 'timestamp';
    arMetricMin[0] := 0.0; arMetricMax[0] := 999999999.0;
    arMetricCenter[0] := 0.0; arMetricAmplitude[0] := 0.0;
    aiWaveformType[0] := 3;
    
    (* Index 1: seq *)
    aMetricNames[1] := 'seq';
